{
  "name": "sorobanpay-backend",
  "version": "1.0.0",
  "description": "Backend services for SorobanPay — event indexer, REST API, and webhook delivery",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "axios": "1.7.7",
    "cors": "2.8.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "pg": "8.13.1",
    "swagger-ui-express": "5.0.1",
    "yamljs": "0.3.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.7.9",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "@types/yamljs": "0.2.34",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3"
  }
}
