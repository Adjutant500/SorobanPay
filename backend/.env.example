# ─── Redis (SEP-10 challenge store) ──────────────────────────────────────────
# Required for multi-instance auth (issue #766).
# Development default (docker-compose.dev.yml already starts redis):
REDIS_URL=redis://localhost:6379

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/sorobanpay?schema=public"

# ─── Redis (cache) ────────────────────────────────────────────────────────────
# Redis connection URL. When not set, all caching is disabled and queries hit
# PostgreSQL directly (graceful fallback — no application errors).
# Docker Compose default: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Cache TTLs in seconds. Adjust to balance freshness vs. query load.
# subscriptions:merchant:{address} keys — how long merchant subscription lists
# are served from cache before the next PostgreSQL query.
CACHE_TTL_SUBSCRIPTIONS=60

# analytics:revenue:{address}:{period} keys — revenue analytics can tolerate
# a longer TTL because aggregates change less frequently than active queries.
CACHE_TTL_ANALYTICS=300

# subscription:{subscriber}:{merchant} keys — individual subscription details.
CACHE_TTL_SUBSCRIPTION_DETAIL=30

# ─── Soroban RPC ─────────────────────────────────────────────────────────────
# Soroban RPC endpoint to poll for contract events.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/<YOUR_KEY>
RPC_URL="https://soroban-testnet.stellar.org"

# Stellar network passphrase — must match the RPC endpoint above.
# Testnet:  Test SDF Network ; September 2015
# Mainnet:  Public Global Stellar Network ; September 2015
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ─── Contract ────────────────────────────────────────────────────────────────
# Deployed SorobanPay contract address (C…).
# Obtain this from the output of: bash deploy/deploy.sh
CONTRACT_ID="CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the Express server listens on. Defaults to 3001 if not set.
PORT=3001

# Base URL used in email unsubscribe links and other absolute URLs.
API_BASE_URL=http://localhost:3001

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Secret used to verify HMAC signatures on incoming webhook requests.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=""

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Set to true when the server runs behind a reverse proxy (nginx, Caddy, etc.)
# so the rate limiter reads the real client IP from X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=false

# ─── OpenTelemetry (BE-66) ───────────────────────────────────────────────────
# Set to true to disable all tracing with zero overhead.
OTEL_SDK_DISABLED=false

# Fraction of requests to sample (0.0 = none, 1.0 = all). Default: 1.0
OTEL_SAMPLING_RATE=1.0

# OTLP HTTP collector endpoint. Jaeger all-in-one default: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Override the service name reported to the collector.
OTEL_SERVICE_NAME=sorobanpay-backend

# ─── Email / SMTP (BE-68) ────────────────────────────────────────────────────
# Set EMAIL_DRY_RUN=false to actually send emails.
# When true (default), emails are logged to console only.
EMAIL_DRY_RUN=true

# SMTP relay configuration (supports SendGrid, AWS SES, Postmark via SMTP relay)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sorobanpay.com

# ─── Admin Dashboard (BE-75) ─────────────────────────────────────────────────
# Secret used to sign admin JWTs (separate from merchant tokens).
# Generate with: openssl rand -hex 32
# Admin tokens must carry { role: "admin" } in their payload.
ADMIN_JWT_SECRET=""

# ─── Payment Retry Queue ─────────────────────────────────────────────────────
# Redis connection URL used by BullMQ for the payment retry queue.
# Format: redis://<host>:<port>  or  redis://<user>:<password>@<host>:<port>
# Leave blank to disable the retry queue (no Bull worker will be started).
REDIS_URL=redis://localhost:6379

# Comma-separated retry delay offsets in days after a payment_transfer_failure.
# Default: 1,3,7  (retry at +1 day, +3 days, +7 days from the failure time).
# Maximum 3 retries. Changing this only affects newly scheduled retries.
RETRY_INTERVALS_DAYS=1,3,7
