# SorobanPay — Docker Compose environment variables
# Copy to .env and fill in values before running `docker compose up`

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=sorobanpay
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=sorobanpay

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sorobanpay:devpassword@postgres:5432/sorobanpay
REDIS_URL=redis://redis:6379
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CONTRACT_ID=
ADMIN_JWT_SECRET=change-me-in-dev-only
PORT=4000

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
